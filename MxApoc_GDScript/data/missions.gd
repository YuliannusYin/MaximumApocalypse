static func get_all() -> Array[MissionData]:
	_ensure_all()
	return _ALL

static func get_by_id(id: int) -> MissionData:
	_ensure_all()
	for m in _ALL:
		if m.id == id:
			return m
	return null

static func get_random() -> MissionData:
	_ensure_all()
	return _ALL[randi() % _ALL.size()]

static func _make(id: int, name: String, difficulty: String, fuel: String, monster_pack: String, intro: String, objective: String, special_setup: String, map_blocks: Dictionary) -> MissionData:
	var m := MissionData.new()
	m.id = id
	m.name = name
	m.difficulty = difficulty
	m.difficulty_order = int(DIFFICULTY_ORDER.get(difficulty, 0))
	m.fuel = fuel
	m.monster_pack = monster_pack
	m.intro = intro
	m.objective = objective
	m.special_setup = special_setup
	m.map_blocks = map_blocks
	m.icon_path = "res://images/missions/mission_%d.png" % id
	return m
