          "english_name": "alien_scientist_extort_equipment",
          "skill_description": "当此怪物卡被玩家抓取时，抓取该卡的玩家弃掉一张装备区内的装备，否则受到六点伤害。",
          "skill_type": "monster",
          "trigger": "after_monster_enter_zone",
          "forced": true,
          "filter": "return true",
          "content": "var drawer = event.player\nvar equip_cards = drawer.get_cards(\"equipment\")\nif equip_cards.is_empty():\n\tawait drawer.damage(6, event[\"card\"])\nelif await drawer.confirm(\"\\\"外星科学家\\\": 是否弃置一张装备，否则受到 6 点伤害\"):\n\tvar chosen = await drawer.choose_card(1, equip_cards)\n\tif chosen.is_empty():\n\t\tawait drawer.damage(6, event[\"card\"])\n\telse:\n\t\tawait drawer.discard(chosen)\nelse:\n\tawait drawer.damage(6, event[\"card\"])"
        },
        {
          "skill_name": "外星科学家-协同强化",
          "english_name": "alien_scientist_synergy",
          "skill_description": "所有外星人类怪物攻击时，造成的伤害加一。",
          "skill_type": "monster",
          "trigger": "on_deal_damage",
          "forced": true,
          "filter": "return event.source.monster_type == \"alien\"",
          "content": "event.num += 1"
        }
