    {
      "monster_name": "外星收割者",
      "english_name": "alien_reaper",
      "monster_level": "boss",
      "count": 1,
      "max_hp": 25,
      "initial_hp": 25,
      "attack_damage": 5,
      "range": "none",
      "skills": [
        {
          "skill_name": "外星收割者-摧毁装备",
          "english_name": "alien_reaper_destroy_equipment",
          "skill_description": "当此怪物卡被玩家抓取后，摧毁场上所有的装备牌。",
          "skill_type": "monster",
          "trigger": "after_monster_enter_zone",
          "forced": true,
          "filter": "return true",
          "content": "var list = game.get_all_players()\nfor i in list:\n\tvar equipment = game.get_cards(i, \"equipment\")\n\tfor c in equipment:\n\t\tawait i.remove_card(c)"
        },
        {
          "skill_name": "外星收割者-烧毁",
          "english_name": "alien_reaper_burn",
          "skill_description": "当此怪物卡攻击时，随机销毁目标玩家区域内的一张牌。",
          "skill_type": "monster",
          "trigger": "on_monster_attack",
          "forced": true,
          "filter": "return true",
          "content": "for target_player in event.target_players:\n\tvar card = game.get_random_card(target_player, [\"hand\", \"equipment\"])\n\tif card != null:\n\t\tawait target_player.remove_card(card)"
        }
      ]
    },
