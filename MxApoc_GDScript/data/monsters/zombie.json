      "monster_level": "normal",
      "max_hp": 5,
      "initial_hp": 5,
      "attack_damage": 4,
      "range": "none",
      "skills": []
    },
    {
      "monster_name": "僵尸士兵",
      "english_name": "zombie_soldier",
      "monster_level": "normal",
      "max_hp": 8,
      "initial_hp": 8,
      "attack_damage": 4,
      "range": "none",
      "skills": []
    },
    {
      "monster_name": "僵尸步行者",
      "english_name": "zombie_walker",
      "monster_level": "normal",
      "max_hp": 4,
      "initial_hp": 4,
      "attack_damage": 2,
      "range": "none",
      "skills": []
    },
    {
      "monster_name": "僵尸步行者（精英）",
