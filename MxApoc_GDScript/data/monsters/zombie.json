      "initial_hp": 12,
      "attack_damage": 5,
      "range": "medium",
      "skills": [
        {
          "skill_name": "僵尸潜行者",
          "english_name": "zombie_stalker",
          "skill_description": "攻击后，修改纠缠目标为场上血量最低的玩家。",
          "skill_type": "monster",
          "trigger": "after_monster_attack",
          "forced": true,
          "filter": "return true",
          "content": "var list = game.get_all_players()\nvar target = list[0]\nfor p in list:\n\tif p.get_hp() < target.get_hp():\n\t\ttarget = p\nself.change_engaged_target(target)"
        }
      ]
    }
  ]
