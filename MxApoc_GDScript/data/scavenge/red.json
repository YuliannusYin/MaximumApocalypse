{
  "$schema": "scavenge_pack",
  "color": "red",
  "cards": [
    {
      "card_name": "医疗用品（便携）",
      "english_name": "medical_supplies_portable",
      "card_type": "action",
      "value": 2,
      "skills": [
        {
          "skill_name": "医疗用品（便携）",
          "english_name": "medical_supplies_portable",
          "skill_description": "恢复2点生命值",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_hp() < player.get_max_hp()",
          "select_target": 1,
          "filter_target": "return target == player",
          "content": "player.recover(2)"
        }
      ]
    },
    {
      "card_name": "医疗用品（小型）",
      "english_name": "medical_supplies_small",
      "card_type": "action",
      "value": 4,
      "skills": [
        {
          "skill_name": "医疗用品（小型）",
          "english_name": "medical_supplies_small",
          "skill_description": "恢复4点生命值",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_hp() < player.get_max_hp()",
          "select_target": 1,
          "filter_target": "return target == player",
          "content": "player.recover(4)"
        }
      ]
    },
    {
      "card_name": "医疗用品（大型）",
      "english_name": "medical_supplies_large",
      "card_type": "action",
      "value": 6,
      "skills": [
        {
          "skill_name": "医疗用品（大型）",
          "english_name": "medical_supplies_large",
          "skill_description": "恢复6点生命值",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_hp() < player.get_max_hp()",
          "select_target": 1,
          "filter_target": "return target == player",
          "content": "player.recover(6)"
        }
      ]
    },
    {
      "card_name": "解毒剂",
      "english_name": "antidote",
      "card_type": "action",
      "skills": [
        {
          "skill_name": "解毒剂",
          "english_name": "antidote",
          "skill_description": "清除所有的异常状态效果",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\"",
          "select_target": 1,
          "filter_target": "return target == player",
          "content": "player.heal_all_status()"
        }
      ]
    },
    {
      "card_name": "燃料",
      "english_name": "fuel",
      "card_type": "equipment",
      "size": 1,
      "charge_type": "fuel",
      "charge_max": 1,
      "charge_initial": 1,
      "skills": [
        {
          "skill_name": "燃料",
          "english_name": "fuel",
          "skill_description": "抓取到此卡时，需要立即装备或者弃掉（不额外消耗行动次数）。",
          "skill_type": "equipment",
          "trigger": "on_draw_scavenge_card",
          "forced": true,
          "filter": "return event.card.english_name == \"fuel\"",
          "content": "var card = event.card\nvar ok = await player.confirm('是否立即装备 \"燃料\", 否则立即弃置')\nif ok:\n\tvar equipped = await player.equip(card)\n\tif not equipped:\n\t\tplayer.discard(card)\nelse:\n\tplayer.discard(card)"
        },
        {
          "skill_name": "加油",
          "english_name": "refuel",
          "skill_description": "行动：选择一个未满的燃料装备，将其填充物填满，然后弃置装备区内最先进入的燃料",
          "skill_type": "equipment",
          "active": "action",
          "target_type": "equipment",
          "usable": -1,
          "select_target": 1,
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "filter_target": "return target.in_equipment_area && target.charge_type == \"fuel\" && target.charge_current < target.charge_max",
          "window_prompt": "\"加油\": 选择未满的燃料装备",
          "content": "player.consume_action(1)\nplayer.fill_charge_to(target)\nvar fuel_to_discard = null\nfor e in player.equipment_zone:\n\tif e.get(\"english_name\") == \"fuel\":\n\t\tfuel_to_discard = e\n\t\tbreak\nif fuel_to_discard != null:\n\tawait player.discard(fuel_to_discard)"
        }
      ]
    }
  ]
}
