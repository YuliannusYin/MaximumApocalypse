{
  "$schema": "scavenge_pack",
  "color": "blue",
  "cards": [
    {
      "card_name": "弹药（少量）",
      "english_name": "ammo_small",
      "card_type": "action",
      "value": 2,
      "skills": [
        {
          "skill_name": "弹药（少量）",
          "english_name": "ammo_small",
          "skill_description": "行动：向一张武器卡填装2发弹药。",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.in_equipment_area && target.charge_type == \"ammo\" && target.charge_current < target.charge_max",
          "content": "player.consume_action(1)\ntarget.add_charge(2, \"ammo\")"
        }
      ]
    },
    {
      "card_name": "弹药（半盒）",
      "english_name": "ammo_half_box",
      "card_type": "action",
      "value": 3,
      "skills": [
        {
          "skill_name": "弹药（半盒）",
          "english_name": "ammo_half_box",
          "skill_description": "行动：向一张武器卡填装3发弹药。",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.in_equipment_area && target.charge_type == \"ammo\" && target.charge_current < target.charge_max",
          "content": "player.consume_action(1)\ntarget.add_charge(3, \"ammo\")"
        }
      ]
    },
    {
      "card_name": "弹药（足量）",
      "english_name": "ammo_full",
      "card_type": "action",
      "value": 4,
      "skills": [
        {
          "skill_name": "弹药（足量）",
          "english_name": "ammo_full",
          "skill_description": "行动：向一张武器卡填装4发弹药。",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.in_equipment_area && target.charge_type == \"ammo\" && target.charge_current < target.charge_max",
          "content": "player.consume_action(1)\ntarget.add_charge(4, \"ammo\")"
        }
      ]
    },
    {
      "card_name": "弹药（大量）",
      "english_name": "ammo_large",
      "card_type": "action",
      "value": 5,
      "skills": [
        {
          "skill_name": "弹药（大量）",
          "english_name": "ammo_large",
          "skill_description": "行动：向一张武器卡填装5发弹药。",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.in_equipment_area && target.charge_type == \"ammo\" && target.charge_current < target.charge_max",
          "content": "player.consume_action(1)\ntarget.add_charge(5, \"ammo\")"
        }
      ]
    },
    {
      "card_name": "弹药（整盒）",
      "english_name": "ammo_full_box",
      "card_type": "action",
      "skills": [
        {
          "skill_name": "弹药（整盒）",
          "english_name": "ammo_full_box",
          "skill_description": "行动：将一张武器卡填装到满弹药。",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.in_equipment_area && target.charge_type == \"ammo\" && target.charge_current < target.charge_max",
          "content": "player.consume_action(1)\ntarget.fill_charge()"
        }
      ]
    },
    {
      "card_name": "防弹背心",
      "english_name": "bulletproof_vest",
      "card_type": "equipment",
      "size": 1,
      "skills": [
        {
          "skill_name": "防弹背心",
          "english_name": "bulletproof_vest",
          "skill_description": "被动：受到的伤害减少2点，使用三次后销毁。",
          "skill_type": "equipment",
          "trigger": "on_take_damage",
          "filter": "return true",
          "forced": true,
          "content": "event.num -= 2\nplayer.add_mark(\"bulletproof_vest_uses\")\nif player.count_mark(\"bulletproof_vest_uses\") >= 3:\n\tplayer.remove_card(\"bulletproof_vest\", \"equipment\")"
        }
      ]
    },
    {
      "card_name": "对讲机",
      "english_name": "walkie_talkie",
      "card_type": "equipment",
      "size": 1,
      "skills": [
        {
          "skill_name": "对讲机",
          "english_name": "walkie_talkie",
          "skill_description": "行动：选择另一名玩家，该玩家立即执行一个行动。",
          "skill_type": "equipment",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.type == \"human\" && target != player",
          "filter_target_range": "infinity",
          "content": "player.consume_action(1)\ntarget.execute_immediate_action(1)"
        }
      ]
    },
    {
      "card_name": "手枪",
      "english_name": "pistol",
      "card_type": "equipment",
      "size": 1,
      "charge_type": "ammo",
      "charge_max": 4,
      "charge_initial": 4,
      "skills": [
        {
          "skill_name": "手枪",
          "english_name": "pistol",
          "skill_description": "行动：对一个目标造成2点伤害。",
          "range": "medium",
          "skill_type": "equipment",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0 && player.get_charge_count(\"pistol\") > 0",
          "select_target": 1,
          "filter_target": "return true",
          "filter_target_range": "medium",
          "content": "player.consume_action(1)\nplayer.consume_charge(player.get_equipment(\"pistol\"), 1)\ntarget.damage(2, player)"
        }
      ]
    },
    {
      "card_name": "背包",
      "english_name": "backpack",
      "card_type": "equipment",
      "size": 0,
      "skills": [
        {
          "skill_name": "背包",
          "english_name": "backpack",
          "skill_description": "被动：玩家增加1格装备栏。",
          "skill_type": "equipment",
          "trigger": "on_card_enter_equipment、on_card_leave_equipment",
          "filter": "return event.card.english_name == \"backpack\"",
          "forced": true,
          "content": "if event.trigger_name == \"on_card_enter_equipment\":\n\tplayer.increase_equipment_slot(1)\nelif event.trigger_name == \"on_card_leave_equipment\":\n\tplayer.decrease_equipment_slot(1)"
        }
      ]
    },
    {
      "card_name": "手电筒",
      "english_name": "flashlight",
      "card_type": "equipment",
      "size": 1,
      "skills": [
        {
          "skill_name": "手电筒",
          "english_name": "flashlight",
          "skill_description": "被动：当你执行拾荒行动时，改为展示牌堆顶两张牌，然后你选择保留其中一张，将另一张置于牌堆底。",
          "skill_type": "equipment",
          "trigger": "before_draw_scavenge_card",
          "filter": "return true",
          "forced": true,
          "content": "event.cancel()\nvar pile = event.pile\nvar top_two = pile.peek_top(2)\nvar keep = await player.choose(top_two)\nplayer.gain(keep)\nfor card in top_two:\n\tif card != keep:\n\t\tpile.put_bottom(card)"
        }
      ]
    },
    {
      "card_name": "双筒望远镜",
      "english_name": "binoculars",
      "card_type": "equipment",
      "size": 1,
      "skills": [
        {
          "skill_name": "双筒望远镜",
          "english_name": "binoculars",
          "skill_description": "行动：展示一张地图块，且不触发它的展示效果。",
          "range": "long",
          "skill_type": "equipment",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.is_map_block() && !target.is_revealed()",
          "filter_target_range": "long",
          "content": "player.consume_action(1)\ntarget.reveal(false, player)"
        }
      ]
    },
    {
      "card_name": "炸药",
      "english_name": "dynamite",
      "card_type": "action",
      "skills": [
        {
          "skill_name": "炸药",
          "english_name": "dynamite",
          "skill_description": "行动：移除一个没有怪物标记的地块上的所有目标标记，并对地块上的所有目标造成8点伤害。",
          "range": "long",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.is_map_block() && !target.has_monster_mark()",
          "filter_target_range": "long",
          "content": "player.consume_action(1)\ntarget.remove_all_objective_marks()\nvar list = game.get_target(target)\nfor i in list:\n\ti.damage(8, player)"
        }
      ]
    },
    {
      "card_name": "大炸药",
      "english_name": "mega_dynamite",
      "card_type": "action",
      "skills": [
        {
          "skill_name": "大炸药",
          "english_name": "mega_dynamite",
          "skill_description": "行动：摧毁一个地图板块。",
          "range": "medium",
          "skill_type": "action",
          "active": "action",
          "filter": "return player.in_phase == \"action\" && player.get_number(\"action_count\") > 0",
          "select_target": 1,
          "filter_target": "return target.is_map_block() && target.is_revealed() && target.is_alive()",
          "filter_target_range": "medium",
          "content": "player.consume_action(1)\nawait game.destroy_map_block(target, player)"
        }
      ]
    }
  ]
}
