    {
      "card_name": "手电筒",
      "english_name": "flashlight",
      "card_type": "equipment",
      "size": 1,
      "skills": [
        {
          "skill_name": "手电筒",
          "english_name": "flashlight",
          "skill_description": "被动：当你执行拾荒行动时，改为展示牌堆顶两张牌，然后你选择保留其中一张，将另一张置于牌堆底。",
          "skill_type": "equipment",
          "trigger": "before_draw_scavenge_card",
          "filter": "return true",
          "window_prompt": "\"手电筒\": 选择保留的牌",
          "forced": true,
          "content": "EventSystem.cancel(event)\nvar pile = event[\"pile\"]\nvar top_two = []\nwhile top_two.size() < 2 and not pile.is_empty():\n\ttop_two.append(pile.draw())\nif top_two.size() == 0:\n\treturn\nif top_two.size() == 1:\n\tgame.log_message(LogColors.player(player.player_name) + \" 从拾荒牌堆获得了 \" + LogColors.card(top_two[0].card_name) + \"（牌堆不足 2 张）\")\n\tawait player.draw_scavenge_card(top_two[0], pile, event)\n\treturn\nvar names = []\nfor c in top_two:\n\tnames.append(c.card_name)\ngame.log_message(LogColors.player(player.player_name) + \" 展示了拾荒牌堆顶 2 张牌: \" + \", \".join(names))\nvar chosen = await player.choose_card(1, top_two)\nvar keep = top_two[0]\nif chosen.size() > 0:\n\tkeep = chosen[0]\ngame.log_message(LogColors.player(player.player_name) + \" 保留了 \" + LogColors.card(keep.card_name))\nawait player.draw_scavenge_card(keep, pile, event)\nfor card in top_two:\n\tif card != keep:\n\t\tpile.put_bottom(card)\n\t\tgame.log_message(LogColors.player(player.player_name) + \" 将 \" + LogColors.card(card.card_name) + \" 置于拾荒牌堆底\")"
        }
      ]
    },
